# Copier ce fichier en .env et remplacer les valeurs.
# .env ne doit JAMAIS être commité (voir .gitignore).

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=carbonghost
POSTGRES_PASSWORD=changeme

# --- Kafka --------------------------------------------------------------
KAFKA_BROKER=kafka:9092

# --- MQTT (Mosquitto) -----------------------------------------------------
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# --- Ports des services (doivent matcher docker-compose.yml) --------------
PORT_USER=8001
PORT_CARBONE=8002
PORT_MESURES=8003
PORT_IA=8004
PORT_ASSISTANT=8005
PORT_FACTORY=8006

# --- Auth / JWT -------------------------------------------------------
JWT_SECRET=changeme-en-production
JWT_EXPIRATION_MINUTES=60

